PORT=4000
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=8h

# --- Base URL used for every app link inside an outgoing email (password reset, welcome/account
# email, interview invitation). Emails are read in someone's inbox on their own device, so these
# links must point at the real public app even when the server itself is running on localhost.
# Leave blank to use the built-in production default (https://hrms.teamlinks.in). Set it only for
# a different environment, e.g. a staging domain. A localhost/127.0.0.1 value is ignored on
# purpose — it would put dead links in real inboxes. ---
APP_BASE_URL=

# --- Real Email delivery for Announcements/Notifications (any SMTP account works, e.g. a
# Gmail account with an "app password", Office365, or a transactional-email SMTP relay). Leave
# blank to leave Email undelivered — sends will be logged as Failed with a clear reason instead
# of crashing the server. ---
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_SECURE=false
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=
EMAIL_FROM=

# --- Real SMS + WhatsApp delivery via Twilio (https://www.twilio.com/console). SMS needs a
# Twilio phone number; WhatsApp needs a Twilio WhatsApp sender (the sandbox number while testing,
# or your own approved WhatsApp Business sender in production). ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=

# --- Google Calendar sync (Integrations > Calendar Sync). Google OAuth Client ID/Secret are
# entered from the Integrations screen itself (stored in the integration_settings table), not
# here — this var only overrides the OAuth redirect URI's origin if the API isn't reachable at
# http://localhost:4000 (e.g. behind a tunnel/proxy). The redirect URI to register in the Google
# Cloud Console is always <that origin>/api/integrations/calendar/callback. ---
GOOGLE_REDIRECT_BASE=

# --- AI Assist (Add Asset / Recruitment / Announcements "AI Assist" buttons) and the AI Assistant
# chat widget run against a LOCAL Ollama instance (https://ollama.com) — no account, no API key,
# no cost, no internet dependency once the model is pulled (`ollama pull llama3.2:3b`). Both
# vars are optional; these are the defaults if left blank. If Ollama isn't running, these features
# show a clear "not running" message instead of crashing. ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
